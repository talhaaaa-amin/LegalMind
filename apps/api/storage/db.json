  "pageContents": {
    "document-1": {
      "40": {
        "sectionTitle": "Notice and Cure",
        "content": "A party must provide written notice of a material delay and allow the contractual cure period before pursuing remedies."
      },
      "41": {
        "sectionTitle": "Notice and Cure",
        "content": "Notice must identify the affected milestone, the anticipated impact, and the action requested from the receiving party."
      },
      "42": {
        "sectionTitle": "Delay Notice Requirements",
        "content": "The delayed party shall provide written notice within ten (10) business days after discovering the delay. The notice must describe the cause, expected duration, and mitigation steps."
      },
      "43": {
        "sectionTitle": "Remedies",
        "content": "Failure to provide timely notice may limit recovery to losses that could not reasonably have been avoided."
      }
    },
    "document-3": {
      "17": {
        "sectionTitle": "Termination",
        "content": "Either party may terminate for material breach after written notice and an opportunity to cure."
      },
      "18": {
        "sectionTitle": "Termination Notice",
        "content": "A termination notice must be delivered in writing and specify the material breach relied upon by the terminating party."
      },
      "19": {
        "sectionTitle": "Post-Termination Obligations",
        "content": "Accrued payment obligations and confidentiality duties survive termination of this agreement."
      }
    },
    "document-4": {
      "54": {
        "sectionTitle": "Closing Conditions",
        "content": "The obligations to close are subject to satisfaction or waiver of the conditions listed in this article."
      },
      "55": {
        "sectionTitle": "Governing Law",
        "content": "This agreement and any dispute arising from it are governed by the laws of the State of Delaware, without regard to conflict-of-law principles."
      },
      "56": {
        "sectionTitle": "Entire Agreement",
        "content": "This agreement constitutes the entire agreement between the parties concerning the transaction."
      }
